# Copy to .env.local and fill in values (never commit .env.local)

# Web3Forms access key for the contact form (https://web3forms.com)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Canonical site URL for Open Graph / metadata
NEXT_PUBLIC_SITE_URL=https://portfolio-tau-eight-23.vercel.app
